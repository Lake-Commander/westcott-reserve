{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/downloads/westcott-reserve.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"westcott-reserve.apk\""
        }
      ]
    }
  ]
}