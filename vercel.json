{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/download-app",
      "destination": "/"
    },
    {
      "source": "/download",
      "destination": "/"
    },
    {
      "source": "/privacy-policy",
      "destination": "/"
    },
    {
      "source": "/terms",
      "destination": "/"
    },
    {
      "source": "/faqs",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/downloads/westcott-reserve.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Westcott Reserve.apk\""
        }
      ]
    }
  ]
}